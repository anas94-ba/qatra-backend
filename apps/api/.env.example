NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://qatra:qatra@localhost:5432/qatra
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# البريد (MailHog/Mailpit في التطوير)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="قطرة <no-reply@qatra.local>"

# اتركه فارغًا لتعطيل CAPTCHA محليًا (Cloudflare Turnstile)
CAPTCHA_SECRET=

# تخزين الملفات: بدون S3_BUCKET تُحفظ محليًا في ./uploads
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# نطاقات رابط التبرع المسموحة (تبدأ بـ wa.me)
DONATION_ALLOWED_DOMAINS=wa.me
REMINDER_AFTER_DAYS=3
JOBS_DISABLED=false

# Seed
SEED_ADMIN_EMAIL=admin@qatra.local
SEED_ADMIN_PASSWORD=
SEED_DEMO=false

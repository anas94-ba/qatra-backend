NODE_ENV=development
PORT=4000
# Hosted Postgres (e.g. Render external URL) usually needs SSL: append ?sslmode=require
DATABASE_URL=postgresql://qatra:qatra@localhost:5432/qatra
DB_POOL_MAX=10
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000

# At least 32 random characters (production refuses to start otherwise)
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Seconds (900) or with a unit (15m, 2h, 1d)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Mail (MailHog/Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="قطرة <no-reply@qatra.local>"

# Leave empty to disable CAPTCHA locally (Cloudflare Turnstile)
CAPTCHA_SECRET=

# File storage: without S3_BUCKET, files are saved locally in ./uploads
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Allowed donation link domains (must include wa.me)
DONATION_ALLOWED_DOMAINS=wa.me
REMINDER_AFTER_DAYS=3
JOBS_DISABLED=false

# Seed
SEED_ADMIN_EMAIL=admin@qatra.local
SEED_ADMIN_PASSWORD=
SEED_DEMO=false

# Swagger UI at /api/docs (always on outside production; set true to enable in production)
SWAGGER_ENABLED=false
